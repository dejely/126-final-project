# Supabase HTTP API URL, not the PostgreSQL connection string.
VITE_SUPABASE_URL=https://[PROJECT_DOMAIN].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_key

VITE_API_BASE_URL=http://localhost:3001/api

# MAL Endpoint
PORT=3001
CLIENT_URL=http://localhost:5173
MAL_CLIENT_ID=your_mal_client_id_here
MAL_CLIENT_SECRET=your_mal_client_secret_here
